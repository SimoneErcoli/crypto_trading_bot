# Kraken API credentials
# Generate at: https://www.kraken.com/u/security/api
# Enable ONLY "Trade" permission — NEVER enable Withdraw
KRAKEN_API_KEY=la_tua_chiave_api
KRAKEN_API_SECRET=il_tuo_secret_api

# Telegram Bot
# Create bot with @BotFather on Telegram to get the token
# Get your CHAT_ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-1234567890
TELEGRAM_CHAT_ID=123456789

# Capital and risk settings
CAPITALE_TOTALE=100
RISCHIO_PER_TRADE=0.015

# Set to "true" for paper trading (no real orders), "false" for live trading
PAPER_TRADING=true
