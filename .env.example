# Kraken API credentials
# Generate at: https://www.kraken.com/u/security/api
# Enable ONLY "Trade" permission — NEVER enable Withdraw
KRAKEN_API_KEY=la_tua_chiave_api
KRAKEN_API_SECRET=il_tuo_secret_api

# Telegram Bot
# Create bot with @BotFather on Telegram to get the token
# Get your CHAT_ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-1234567890
TELEGRAM_CHAT_ID=123456789

# Capital and risk settings
# CAPITALE_TOTALE is used only in paper mode; in live mode the bot sizes
# positions from the real Kraken equity (EUR balance + open positions).
CAPITALE_TOTALE=100
RISCHIO_PER_TRADE=0.015

# Set to "true" for paper trading (no real orders), "false" for live trading
PAPER_TRADING=true

# Trading strategy: "conservative" (default), "aggressive" or "scalping"
# conservative: 10 asset, candele 4h, RSI 35-50, EMA50, SL -3%, TP1 +5%, TP2 +10%, cooldown 4h
# aggressive:   10 asset, candele 4h, RSI 30-58, EMA20, SL -1.5%, TP1 +3%, TP2 +7%, TP3 +15%, cooldown 1h
# scalping:     solo BTC, candele 15m, scan ogni 5 min, EMA9/21 + EMA50,
#               una posizione alla volta, SL ATR (max -0.8%), TP1 +1.2% (50%),
#               TP2 +2.5%, trailing 0.8%, time-exit 6h, cooldown 30 min,
#               sizing dinamico su equity Kraken reale
STRATEGIA=conservative
